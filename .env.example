# Copy to .env (gitignored) and fill in. Real environment variables win over this file.
# api and worker read it via spring.config.import; for ./mvnw run: set -a; source .env; set +a

# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_api_key

# Bearer token for /admin/* on the api; any long random string
ADMIN_TOKEN=your_admin_token

# Password of the rag_app database user (created by Flyway V3 on first start); unset means rag_app (local only)
# APP_DB_PASSWORD=choose_one
